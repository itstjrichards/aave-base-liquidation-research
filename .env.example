# Read-only RPC endpoint. Use a Base RPC provider (e.g. Alchemy, Infura, or a public endpoint).
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Health factor watcher tuning (all optional, defaults shown).
# AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# HF_POLL_INTERVAL_MS=30000
# Alert severity tiers — must satisfy HF_CRITICAL_THRESHOLD < HF_WARNING_THRESHOLD < HF_WATCH_THRESHOLD.
# HF_WATCH_THRESHOLD=1.10
# HF_WARNING_THRESHOLD=1.05
# HF_CRITICAL_THRESHOLD=1.02
# EVENT_LOOKBACK_BLOCKS=5000
# LOG_CHUNK_BLOCKS=2000
# LOG_FETCH_CONCURRENCY=6
# RPC_MIN_INTERVAL_MS=300
# MULTICALL_BATCH_SIZE=150

# Liquidation simulation tuning (all optional, defaults shown).
# ANVIL_PATH=anvil
# ANVIL_PORT_RANGE_START=30000
# ANVIL_PORT_RANGE_END=40000
# ANVIL_STARTUP_TIMEOUT_MS=30000
# ANVIL_COMPUTE_UNITS_PER_SECOND=20
# ANVIL_FORK_RETRIES=15
# ANVIL_FORK_RETRY_BACKOFF_MS=2000
# DEBT_ACQUISITION_BUFFER_BPS=50

# Opportunity log + outcome tracker (all optional, defaults shown).
# DB_PATH=data/opportunities.db
# LIQUIDATION_CHECK_DELAY_BLOCKS=5
# LIQUIDATION_CHECK_MAX_BLOCKS=30
# LIQUIDATION_CHECK_CHUNK_BLOCKS=10
# LIQUIDATION_OUTCOME_CHECK_INTERVAL_MS=15000

# Early-warning alert log (separate from the opportunity log; optional, default shown).
# ALERTS_DB_PATH=data/alerts.db

# Historical simulation of liquidations seen on-chain after the fact (all optional, defaults shown).
# Each replay forks Anvil one block before the real liquidation, so it costs RPC compute units.
# HISTORICAL_SIM_ENABLED=true
# HISTORICAL_SIM_MIN_INTERVAL_MS=90000
# HISTORICAL_SIM_MAX_ATTEMPTS=3

# Borrower discovery + tiered polling (all optional, defaults shown).
# Historical / catch-up log scans use a free public RPC so the primary (metered) key only serves the live tail.
# DISCOVERY_RPC_URL=https://mainnet.base.org
# DISCOVERY_LOOKBACK_BLOCKS=15768000    # ~1 year of Borrow events, scanned once then saved (to rescan further back: delete the deep_backfill_* rows from kv_state in data/borrowers.db)
# DISCOVERY_LOG_CHUNK_BLOCKS=2000
# DISCOVERY_CONCURRENCY=3
# DISCOVERY_MIN_INTERVAL_MS=250
# BORROWERS_DB_PATH=data/borrowers.db
# Borrowers below HF_HOT_THRESHOLD are polled every tick on the primary RPC; the rest are swept on the free RPC.
# HF_HOT_THRESHOLD=1.15                 # must be above HF_WATCH_THRESHOLD
# COLD_SWEEP_INTERVAL_MS=180000

# Ignore sub-1.0 positions with less debt than this (USD) — dust that can never cover gas (default shown).
# MIN_OPPORTUNITY_DEBT_USD=10

# Hot borrowers are polled on the free discovery RPC (falling back to the primary). Set true to use the primary instead.
# HOT_POLL_ON_PRIMARY=false
